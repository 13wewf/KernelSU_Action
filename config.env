# 内核源码地址
KERNEL_SOURCE=https://github.com/plmzaq2112/android_kernel_mt6765.git

# 源码分支
KERNEL_SOURCE_BRANCH=main

# 配置文件名称
KERNEL_CONFIG=blossom_defconfig

# 镜像名称
KERNEL_IMAGE_NAME=Image.gz-dtb

# 选择变体：ReSukiSU
KSU_VARIANT=resukisu

# 指定稳定版本，千万别留空
KSU_REF=v4.2.0-rc1

# 核心配置：强制使用手动钩子，开启必要选项
KSU_MANUAL_HOOK=true
EXTRA_DEFCONFIG="CONFIG_KSU_MANUAL_HOOK=y CONFIG_KALLSYMS_ALL=y CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y"
