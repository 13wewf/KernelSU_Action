KERNEL_SOURCE=https://github.com/plmzaq2112/android_kernel_mt6765.git
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=blossom_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
CLANG_BRANCH=android12-release
CLANG_VERSION=r416183b

# 回归官方 KernelSU 变体
KSU_VARIANT=official

# 你的内核是 4.19，官方强制要求必须使用 manual（手动 Hook）
KSU_MANUAL_HOOK=true

# 开启必要配置
EXTRA_DEFCONFIG="CONFIG_KSU=y CONFIG_KSU_MANUAL_HOOK=y CONFIG_KALLSYMS_ALL=y"
